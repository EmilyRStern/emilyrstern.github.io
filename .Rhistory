# Define a custom th
my_theme <- theme(
text = element_text(family = "poppins"),  # Apply Poppins font globally to all text
plot.title = element_text(color = "darkgrey", size = 16, face = "bold"),
axis.title = element_text(color = "darkgrey", size = 14),
axis.text = element_text(color = "darkgrey", size = 12),
panel.background = element_rect(fill = "white", color = NA),  # Set panel background to white
plot.background = element_rect(fill = "white", color = NA),   # Set plot background to white
panel.grid.major = element_line(color = "grey90"),            # Light grid lines for major grid
panel.grid.minor = element_line(color = "grey95"),            # Lighter grid lines for minor grid
panel.border = element_rect(color = "black", fill = NA),      # Add a border around the plot
legend.background = element_rect(fill = "white", color = NA)  # Set legend background to white
)
ggplot(mtcars, aes(x = mpg)) +
geom_histogram(binwidth = 2, fill = "slateblue", color = "slateblue4") +
labs(title = "Distribution of Miles Per Gallon (mpg)", x = "Miles Per Gallon", y = "Count") +
my_theme
