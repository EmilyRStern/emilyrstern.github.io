knitr::opts_chunk$set(echo = TRUE)
# Load the necessary libraries and data set
library(ggplot2)
library(scales)
library(dplyr)
library(tidyr) # For pivot_longer function
library(gridExtra)
library(ggthemes) # For additional themes
library(RColorBrewer) # For color palettes
data(diamonds)
##### Chart 1 data #####
carat_price <- diamonds %>%
mutate(carat_price = price / carat) %>%  # Calculate carat price
group_by(clarity) %>%                     # Group by clarity
summarize(
avg_price_per_carat = mean(carat_price, na.rm = TRUE),  # Average price per carat
avg_size = mean(carat, na.rm = TRUE),                   # Average size
)
rounded <- carat_price %>%
mutate(rounded_price_per_carat = round(avg_price_per_carat, 2))
library(tidyverse)
library(sysfonts)
font_add_google("Poppins", "poppins")
